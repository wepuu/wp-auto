# Copy to /opt/wpauto/config/runtime.env, set mode 0600, and replace every
# SET_ON_VPS value. Never commit the completed file.
WEPUU_CONTROL_IMAGE=ghcr.io/wepuu/wp-auto-control:git-SET_ON_VPS
WEPUU_AUTHORIZATION_IMAGE=ghcr.io/wepuu/wp-auto-authorization:git-SET_ON_VPS
WEPUU_POSTGRES_PASSWORD=SET_ON_VPS
WEPUU_DATABASE_URL=postgresql://wpauto:SET_ON_VPS@postgres:5432/wpauto
WEPUU_ACCOUNT_OIDC_CLIENT_SECRET=SET_ON_VPS
WEPUU_GRANT_IDEMPOTENCY_HMAC_KEY=SET_ON_VPS
WEPUU_COOKIE_KEYS_JSON=SET_ON_VPS
WEPUU_OAUTH_ARTIFACT_KEYS_JSON=SET_ON_VPS
WEPUU_RATE_LIMIT_HMAC_KEY=SET_ON_VPS
WEPUU_OPERATIONS_METRICS_TOKEN=SET_ON_VPS
WEPUU_DATA_REGION_LABEL=SET_ON_VPS
WEPUU_RELEASE_VERSION=0.5.0
WEPUU_RELEASE_REVISION=SET_ON_VPS
WEPUU_RETENTION_POLICY_VERSION=2026-10-09
WEPUU_COMPATIBILITY_MATRIX_VERSION=2026-10
