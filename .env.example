# Local/test placeholders only. Never store secrets or production values in this file.
WEPUU_DEPLOYMENT_MODE=local
WEPUU_PRODUCT_NAME=WePuu Platform
WEPUU_CONTROL_PUBLIC_ORIGIN=https://platform.example.test
WEPUU_LEGAL_PROVIDER_NAME=Provider details pending
WEPUU_DATA_REGION_LABEL=Not selected
WEPUU_TRUSTED_PROXY_CIDRS_JSON=[]
WEPUU_RELEASE_VERSION=0.5.0-preview
WEPUU_RELEASE_REVISION=uncommitted
WEPUU_IDENTITY_PROVIDER_LABEL=Identity provider pending
WEPUU_RETENTION_POLICY_VERSION=Policy pending
WEPUU_COMPATIBILITY_MATRIX_VERSION=2026-10-preview
WEPUU_SIGNING_KEY_SLOT=primary
WEPUU_EMAIL_DELIVERY=mock
WEPUU_RESEND_FROM=WePuu <login@example.test>
WEPUU_EMAIL_OTP_SEND_WINDOW_SECONDS=60
WEPUU_EMAIL_OTP_SEND_MAX=1
WEPUU_EMAIL_OTP_VERIFY_WINDOW_SECONDS=300
WEPUU_EMAIL_OTP_VERIFY_MAX=5

# Production requires final HTTPS URLs and at least one explicit trusted proxy CIDR.
# WEPUU_TERMS_URL=https://...
# WEPUU_PRIVACY_URL=https://...
# WEPUU_SUPPORT_URL=https://...
# WEPUU_STATUS_URL=https://...
# WEPUU_OPERATIONS_METRICS_TOKEN=<random secret of at least 32 characters>

# Paths are injected by the runtime, never populated with key values.
# WEPUU_SIGNING_KEYRING_FILE=/run/secrets/signing_keyring
# WEPUU_ACCOUNT_AUTH_SECRETS_FILE=/run/secrets/account_auth_secrets
# WEPUU_RESEND_API_KEY_FILE=/run/secrets/resend_api_key
